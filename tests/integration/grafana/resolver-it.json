{
  "uid": "ayon-resolver-it",
  "title": "AYON USD Resolver - integration tests",
  "description": "Records published by tests/integration in ayon-usd-resolver. Pick a run; trends follow the time range.",
  "tags": [
    "ayon",
    "usd-resolver",
    "tests"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "run_id",
          "stream": "{job=\"resolver_it\"}",
          "refId": "run"
        },
        "refresh": 2,
        "sort": 2,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "backend",
        "label": "Backend",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "backend",
          "stream": "{job=\"resolver_it\",kind=\"session\"}",
          "refId": "backend"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Log search",
        "type": "textbox",
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Run $run_id",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Tests passed",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "w": 4,
        "y": 1,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"resolver_it\",run_id=\"$run_id\",kind=\"test\"} | json | outcome=\"passed\" [$__range]))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Tests failed",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 4,
        "w": 4,
        "y": 1,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"resolver_it\",run_id=\"$run_id\",kind=\"test\"} | json | outcome!=\"passed\" [$__range]))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Sessions not composed",
      "description": "Resolver sessions whose resolved paths or prim count differ from the seeded manifest.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "w": 4,
        "y": 1,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"resolver_it\",run_id=\"$run_id\",kind=\"session\",backend=~\"$backend\"} | json | composed=\"false\" [$__range]))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "AYON resolves in warm sessions",
      "description": "URIs sent to /api/resolve by sessions running against a filled cache. Above 0 means the cache was bypassed.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "w": 4,
        "y": 1,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({job=\"resolver_it\",run_id=\"$run_id\",kind=\"session\",backend=~\"$backend\",session=\"warm\"} | json | unwrap ayon_resolve_uris | __error__=\"\" [$__range]))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "AYON errors",
      "description": "4xx/5xx responses seen by ayon-tap during resolver sessions, injected faults included.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "w": 4,
        "y": 1,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({job=\"resolver_it\",run_id=\"$run_id\",kind=\"session\",backend=~\"$backend\"} | json | unwrap ayon_errors | __error__=\"\" [$__range]))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Resolver build",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 20,
        "w": 4,
        "y": 1,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count by (build) (count_over_time({job=\"resolver_it\",run_id=\"$run_id\"} [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{build}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "center"
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Resolver sessions",
      "description": "One row per resolver process. AYON columns come from ayon-tap; mc columns are memcached counter changes (empty on Dragonfly). The trace link opens the session in Tempo with every AYON request it made.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "w": 24,
        "y": 5,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"resolver_it\",run_id=\"$run_id\",kind=\"session\",backend=~\"$backend\"}",
          "queryType": "range",
          "legendFormat": "",
          "maxLines": 1000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "uris": true
            },
            "indexByName": {
              "Time": 0,
              "test": 1,
              "session": 2,
              "backend": 3,
              "prewarm": 4,
              "composed": 5,
              "ok": 6,
              "open_ms": 7,
              "prims": 8,
              "ayon_resolve_uris": 9,
              "ayon_resolve_requests": 10,
              "ayon_requests": 11,
              "ayon_site_roots": 12,
              "ayon_errors": 13,
              "mc_get_hits": 14,
              "mc_get_misses": 15,
              "mc_cmd_set": 16,
              "trace_id": 17
            },
            "renameByName": {
              "open_ms": "open (ms)",
              "ayon_resolve_uris": "AYON URIs",
              "ayon_resolve_requests": "AYON resolve reqs",
              "ayon_requests": "AYON reqs",
              "ayon_site_roots": "siteRoots",
              "ayon_errors": "AYON errors",
              "mc_get_hits": "mc hits",
              "mc_get_misses": "mc misses",
              "mc_cmd_set": "mc sets",
              "trace_id": "trace"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "",
                    "internal": {
                      "datasourceUid": "tempo",
                      "datasourceName": "Tempo",
                      "query": {
                        "query": "${__value.raw}",
                        "queryType": "traceql"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 290
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "composed"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "yes",
                        "color": "green"
                      },
                      "false": {
                        "text": "NO",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "test"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 8
    },
    {
      "type": "row",
      "id": 9,
      "title": "Cache effect in $run_id",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "barchart",
      "title": "AYON URIs resolved per session",
      "description": "Cold sessions ask AYON for the whole closure; warm sessions should ask for nothing.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "w": 8,
        "y": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max by (backend, prewarm, session) (max_over_time({job=\"resolver_it\",run_id=\"$run_id\",kind=\"session\",backend=~\"$backend\"} | json | unwrap ayon_resolve_uris | __error__=\"\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{backend}} \u00b7 prewarm {{prewarm}} \u00b7 {{session}}"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Field"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "Field",
        "showValue": "always",
        "barWidth": 0.7,
        "colorByField": "Field",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 10
    },
